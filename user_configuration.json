    "custom_commands": [
  	    "git clone https://github.com/LeoXOc/dotfiles.git /home/user/dotfiles",
  	    "chown -R user:user /home/user/dotfiles",
  	    "chmod +x /home/user/dotfiles/install.sh",
  	    "echo 'user ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/temp_nopasswd",
  	    "su - user -c 'bash /home/user/dotfiles/install.sh'",
  	    "rm /etc/sudoers.d/temp_nopasswd"
