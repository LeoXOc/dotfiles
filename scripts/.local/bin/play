#!/bin/bash

# $1 es el nombre (por defecto 'all'), $2 es el volumen (por defecto 60)
name="${1:-all}"
vol="${2:-60}"

PATHS="$HOME/.paths/$name.txt"
dir="$HOME/.playlist"
playlist="$name.m3u"
playlist_path="$dir/$playlist"

killall mpv 2>/dev/null
mkdir -p "$dir"

# --- FUNCIONES ---
get_files() {
    local target_path="$1"
    echo "Processing: $target_path"
    
    if [[ ! -d "$target_path" ]]; then
        echo "Error: Directory not found -> $target_path"
        return
    fi

    # Archivo de lista negra
    local blacklist_file="$HOME/.play/blacklist.txt"

    # Preparamos el comando de búsqueda base
    local find_cmd=(find "$target_path" -type f \
        ! -name "*.jpg" ! -name "*.png" ! -name "*.webp" ! -name "*.gif" \
        ! -name "*.txt" ! -name "*.nfo" ! -name "*.srt")

    if [[ -f "$blacklist_file" ]]; then
        # Si existe la lista negra, filtramos con grep
        "${find_cmd[@]}" | grep -vFf "$blacklist_file" | while IFS= read -r archivo; do
            file=$(basename "$archivo")
            echo "#EXTINF:-1,$file" >> "$playlist_path"
            echo "$archivo" >> "$playlist_path"
        done
    else
        # Si no existe la lista negra, procedemos normal
        "${find_cmd[@]}" | while IFS= read -r archivo; do
            file=$(basename "$archivo")
            echo "#EXTINF:-1,$file" >> "$playlist_path"
            echo "$archivo" >> "$playlist_path"
        done
    fi
    echo "$playlist updated with $target_path!"
}

process_line() {
    local current_line="$1"
    
    # Si por costumbre dejaste "tema:ruta" en el txt, esto extrae solo la ruta.
    # Si solo pusiste la "ruta" pura, la deja intacta. A prueba de fallos.
    local line_path="${current_line#*:}"

    # Expandimos la ~ al directorio HOME real
    line_path="${line_path/#\~/$HOME}"
    
    # Como ya estamos leyendo el archivo correcto, procesamos la ruta directamente
    get_files "$line_path"
}

# --- LÓGICA DE ACTUALIZACIÓN ---
# Inicializamos variables
lineas_playlist=0
dias_antiguedad=0

if [[ -f "$playlist_path" ]]; then
    # Contar líneas de la playlist para saber si está rota
    lineas_playlist=$(wc -l < "$playlist_path")
    
    # Calcular los días desde la última modificación del archivo
    tiempo_actual=$(date +%s)
    tiempo_archivo=$(stat -c %Y "$playlist_path")
    dias_antiguedad=$(( (tiempo_actual - tiempo_archivo) / 86400 ))
fi

# Actualiza si: 1. No existe | 2. Tiene 7 o más días | 3. Está corrupta (<= 1 línea)
if [[ ! -f "$playlist_path" ]] || [[ "$dias_antiguedad" -ge 7 ]] || [[ "$lineas_playlist" -le 1 ]]; then
    echo "Playlist inexistente, corrupta o caducada ($dias_antiguedad días). Generando nueva lista..."
    echo "#EXTM3U" > "$playlist_path"
    
    if [[ ! -f "$PATHS" ]]; then
        echo "Error: Config file not found at $PATHS"
        exit 1
    fi

    # Le pasamos la línea como parámetro a la función para mayor estabilidad
    while IFS= read -r line || [[ -n "$line" ]]; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        process_line "$line"
    done < "$PATHS"
else
    echo "Usando la playlist en caché ($dias_antiguedad días de antigüedad): $playlist_path"
fi

TERMINAL_ID=$(xdotool getactivewindow)

# --- REPRODUCCIÓN ---
echo "Starting $playlist on MPV player at volume $vol%!"

mpv --player-operation-mode=pseudo-gui \
    --audio-device="pulse/alsa_output.pci-0000_00_1b.0.analog-stereo" \
    --volume="$vol" \
    --shuffle \
    --loop-playlist=inf \
    --no-border \
    --no-osc --no-osd-bar \
    --title="MPV_player" \
    --playlist="$playlist_path" > /dev/null 2>&1 &

echo "Waiting for MPV window to map..."

for i in {1..20}; do
    if wmctrl -l | grep -q "MPV_player"; then
        sleep 0.5
        # Mandamos MPV al fondo
        wmctrl -r "MPV_player" -b add,below

        # Le devolvemos el foco a Kitty
        xdotool windowactivate "$TERMINAL_ID"

        echo "MPV player sent to background and focus restored to Kitty!"
        break
    fi
    sleep 0.5
done

echo "Done!"
exit 0
