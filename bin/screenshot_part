#!/bin/bash

# Estructura de carpetas idéntica
FECHA_DIR=$(date +%Y/%m)
NOMBRE_BASE=$(date +%Y%m%d.%H%M%S)
DESTINO="$HOME/Screenshots/$FECHA_DIR"

mkdir -p "$DESTINO"

# El nombre llevará el sufijo .win para diferenciarlo del total
ARCHIVO_FINAL="$DESTINO/Selection_$NOMBRE_BASE.png"

# Capturar SOLO la ventana con el foco (-u)
# Añadimos un pequeño retraso (-d 1) para que no salga el menú si usas atajos
scrot -s -d 1 "$ARCHIVO_FINAL" -q 100

# Copiar al portapapeles
xclip -selection clipboard -t image/png -i "$ARCHIVO_FINAL"

# Notificación
notify-send "Captura de Ventana" "Copiada al portapapeles y guardada." -i "$ARCHIVO_FINAL"
