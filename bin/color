#!/bin/bash

# --- LÓGICA ALEATORIA ---
# Si el argumento es "random" o está vacío, elegimos uno al azar
if [ "$1" == "random" ] || [ -z "$1" ]; then
    # Array con los temas disponibles
    THEMES=("matrix" "rust" "toxic" "ghost" "pink" "emerald" "amber"
      "neon" "ice" "aurora" "cobalt" "ultraviolet" "lava" "copper"
      "gold" "crimson" "sunset" "shadow" "void" "obsidian" "blood"
      "mint" "sakura" "solar" "ocean" "retro")

    # Elegimos uno usando el generador de números aleatorios de bash
    SELECTED_THEME=${THEMES[$RANDOM % ${#THEMES[@]}]}

    echo "🎲 Modo aleatorio: Seleccionado tema '$SELECTED_THEME'"

    # Nos llamamos a nosotros mismos recursivamente con el tema elegido
    # "$0" es el nombre de este mismo script
    bash "$0" "$SELECTED_THEME"
    exit 0
fi

# --- LÓGICA DE APLICACIÓN (Tu código original) ---

inject_theme() {
    local TARGET_TERM=$1
    local TEXT=$2
    local ACCENT=$3

    printf "\033]10;%s\a" "$TEXT" > "$TARGET_TERM"
    printf "\033]12;%s\a" "$TEXT" > "$TARGET_TERM"
    printf "\033]4;2;%s\a" "$ACCENT" > "$TARGET_TERM"
    printf "\033]4;10;%s\a" "$ACCENT" > "$TARGET_TERM"
}

case "$1" in
    "matrix")
        TEXT="#00FF41"; ACCENT="#00FF41" ;;
    "rust")
        TEXT="#DEA584"; ACCENT="#FF8C00" ;;
    "toxic")
        TEXT="#ADFF2F"; ACCENT="#CCFF00" ;;
    "ghost")
        TEXT="#E0E0E0"; ACCENT="#FFFFFF" ;;
    "pink")
        TEXT="#FF00FF"; ACCENT="#FF00CC" ;;
    "emerald")
        TEXT="#2ECC71"; ACCENT="#27AE60" ;;
    "amber")
        TEXT="#FFB000"; ACCENT="#FFD700" ;;
    # --- Fríos / Ciberpunk ---
    "neon")
        TEXT="#FF2D9B"; ACCENT="#BF00FF" ;;   # rosa neón + violeta
    "ice")
        TEXT="#A8DAFF"; ACCENT="#00BFFF" ;;   # azul hielo + cyan eléctrico
    "aurora")
        TEXT="#57FFB8"; ACCENT="#5E81F4" ;;   # verde aurora + índigo
    "cobalt")
        TEXT="#6CB4FF"; ACCENT="#0047AB" ;;   # azul cobalto claro/oscuro
    "ultraviolet")
        TEXT="#CF9FFF"; ACCENT="#7B2FBE" ;;   # lavanda + violeta profundo

    # --- Cálidos / Orgánicos ---
    "lava")
        TEXT="#FF4500"; ACCENT="#FF6A00" ;;   # rojo lava + naranja
    "copper")
        TEXT="#DA8A67"; ACCENT="#B87333" ;;   # cobre claro + cobre oscuro
    "gold")
        TEXT="#FFD700"; ACCENT="#B8860B" ;;   # oro brillante + oro oscuro
    "crimson")
        TEXT="#FF355E"; ACCENT="#C41E3A" ;;   # rojo carmesí neón + oscuro
    "sunset")
        TEXT="#FF7043"; ACCENT="#FF1744" ;;   # naranja atardecer + rojo

    # --- Oscuros / Misteriosos ---
    "shadow")
        TEXT="#8892A4"; ACCENT="#4A5568" ;;   # gris azulado apagado
    "void")
        TEXT="#6A0DAD"; ACCENT="#2D0057" ;;   # púrpura oscuro + casi negro
    "obsidian")
        TEXT="#B0BEC5"; ACCENT="#607D8B" ;;   # gris azul claro/oscuro
    "blood")
        TEXT="#CC0000"; ACCENT="#800000" ;;   # rojo sangre + granate

    # --- Raros / Únicos ---
    "mint")
        TEXT="#98FF98"; ACCENT="#00FA9A" ;;   # verde menta suave + fuerte
    "sakura")
        TEXT="#FFB7C5"; ACCENT="#FF69B4" ;;   # rosa sakura + hot pink
    "solar")
        TEXT="#FFF176"; ACCENT="#FFCA28" ;;   # amarillo solar pálido + dorado
    "ocean")
        TEXT="#00CED1"; ACCENT="#006994" ;;   # turquesa + azul océano
    "retro")
        TEXT="#F8F8F2"; ACCENT="#F92672" ;;   # blanco Monokai + rosa retro
    *)
        echo "Tema no reconocido."
        exit 1
        ;;
esac

echo "Aplicando modo $1 a todas las terminales..."

MY_TERMS=$(find /dev/pts/ -mindepth 1 -maxdepth 1 -user "$USER" -name "[0-9]*")
for term in $MY_TERMS; do
    if [ -w "$term" ]; then
        inject_theme "$term" "$TEXT" "$ACCENT"
    fi
done
